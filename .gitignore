# Rust — workspace shares a single target/ at the root; catch stray ones too.
/target/
**/target/
**/*.rs.bk
*.pdb

# Neural net artifacts — weights/checkpoints are data, not source.
# Track configs and training code; keep large binaries out of git (Garage S3).
*.pt
*.onnx
*.safetensors
*.nnue
*.ckpt
training/data/
training/weights/
training/checkpoints/

# Bulk training/test game data and large opening books.
*.binpack
books/*.pgn
books/*.epd

# Python (training/)
__pycache__/
*.py[cod]
.venv/
.python-version

# Web (ui/)
node_modules/
ui/dist/

# Local env / secrets (e.g. Lichess bot API token)
.env
*.local

# Editor / OS
.DS_Store
